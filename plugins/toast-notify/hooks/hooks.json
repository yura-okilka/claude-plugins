{
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& '${CLAUDE_PLUGIN_ROOT}/hooks/notify-toast.ps1'\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& '${CLAUDE_PLUGIN_ROOT}/hooks/notify-toast.ps1' -OnlyIfUnfocused\"",
            "async": true
          }
        ]
      }
    ]
  }
}
